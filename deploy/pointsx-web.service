# systemd unit for PointsX on a Linux VPS
# Install:
#   1. Edit User=, WorkingDirectory=, and ExecStart= paths below
#   2. sudo cp deploy/pointsx-web.service /etc/systemd/system/pointsx-web.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now pointsx-web
#   5. sudo systemctl status pointsx-web

[Unit]
Description=PointsX FitMeasure web UI (FastAPI / uvicorn)
After=network.target

[Service]
Type=simple
User=pointsx
Group=pointsx
WorkingDirectory=/opt/PointsX
Environment=POINTSX_DEVICE=cpu
Environment=POINTSX_WEB_HOST=127.0.0.1
Environment=POINTSX_WEB_PORT=8000
ExecStart=/opt/PointsX/.venv/bin/pointsx-web --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
