# Copy to .env (local) or paste into the HF Space's "Variables and secrets"
# panel. NOTHING in this file is required — the demo runs without storage and
# without CORS overrides.

# ── Pipeline / models ──────────────────────────────────────────────────────
# Auto-resolved relative to the working directory at startup. Override only
# if you move weights to a non-standard location.
# POINTSX_POSE_MODEL_CUSTOM=models/pose-cus.pt
# POINTSX_POSE_MODEL_COCO=models/yolo26-pose.pt
# POINTSX_SEG_MODEL=models/yolo12l-person-seg-extended.pt
# POINTSX_REGRESSION_MODEL=models/circumference_regressor.pt
# POINTSX_DEVICE=auto

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist for the demo. Use "*" for open access
# (fine for a scientific demo), or pin to the Vercel domain in production.
# CORS_ALLOW_ORIGINS=https://your-demo.vercel.app,https://your-domain.example
CORS_ALLOW_ORIGINS=*

# ── TTS ────────────────────────────────────────────────────────────────────
# Server-side voice synthesis for /api/tts.
#   POINTSX_TTS_DISABLE=1    return 503 immediately, frontend uses browser voice
#   POINTSX_TTS_VOICE        edge-tts voice id (uk-UA-PolinaNeural | uk-UA-OstapNeural)
#   POINTSX_TTS_BACKEND      force "edge" or "gtts"; default "auto" tries edge first,
#                            falls back to gTTS when Microsoft blocks the WSS.
# POINTSX_TTS_DISABLE=
# POINTSX_TTS_VOICE=uk-UA-PolinaNeural
# POINTSX_TTS_BACKEND=auto

# ── HF Storage Bucket / local data directory ───────────────────────────────
# When set, photos and envelope JSON are written under
#   <LOCAL_DATA_DIR>/measurements/<request_id>/
# and model weights are looked up at
#   <LOCAL_DATA_DIR>/models/<filename>.
# HF Spaces with an attached Storage Bucket mount it at /data — set this to
# /data on the Space. Leave blank to use S3/HF Hub only.
LOCAL_DATA_DIR=/data

# ── Model weights ─────────────────────────────────────────────────────────
# Source priority:
#   1. HF Hub model repo (recommended — free, unlimited public bandwidth)
#   2. S3 bucket under MODELS_S3_KEY_PREFIX (fallback when HF_MODELS_REPO empty)
#
# Set HF_MODELS_REPO to a public model repo containing the weights at the
# top level. Each weight is fetched only if the local path is missing.
#
# Expected files in the repo:
#   yolo26-pose.pt
#   yolo12l-person-seg-extended.pt
#   circumference_regressor.pt   (optional)
HF_MODELS_REPO=Secret0123/pointx-models
# Branch / tag / commit. "main" is fine for most cases.
HF_MODELS_REVISION=main
# Required only if the repo is PRIVATE — public repos download without a token.
# HF_TOKEN=

# ── Object-storage archival (any S3-compatible provider) ───────────────────
# Set the four required vars to turn archival on. Photos + envelope JSON go
# to <bucket>/<prefix>measurements/<request_id>/. Leave blank to disable.
#
# The loader accepts these prefixes (whichever group is complete wins):
#   S3_*   canonical (recommended for new setups)
#   ELK_*  ElasticLake — paste their example .env block as-is
#   R2_*   Cloudflare R2 examples
#   B2_*   Backblaze B2 examples
#   AWS_*  AWS / boto3 native names
#
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#
# Backblaze B2 example:
#   S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#   S3_REGION=<region>            (e.g. us-west-004)
#
# AWS S3 example:
#   S3_ENDPOINT=https://s3.amazonaws.com
#   S3_REGION=us-east-1
#
# ElasticLake example (from their docs — paste the block they give you):
#   ELK_ENDPOINT=https://...
#   ELK_ACCESS_KEY_ID=...
#   ELK_SECRET_ACCESS_KEY=...
#   ELK_BUCKET=...
#   ELK_REGION=...
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Region: "auto" works only for Cloudflare R2. Use "us-east-1" (or whatever
# the provider documents) if your provider doesn't accept "auto".
S3_REGION=us-east-1
S3_PREFIX=
# Where the backend looks for model weights INSIDE the same bucket. The
# container pulls these on startup if local files are missing; once cached
# they stay across warm restarts. Expected objects under this prefix:
#   <MODELS_S3_KEY_PREFIX>yolo26-pose.pt
#   <MODELS_S3_KEY_PREFIX>yolo12l-person-seg-extended.pt
#   <MODELS_S3_KEY_PREFIX>circumference_regressor.pt   (optional)
MODELS_S3_KEY_PREFIX=models/
# Addressing-style override. Auto-detected by default:
#   AWS S3 (amazonaws.com endpoint) → virtual-hosted
#   Everything else                 → path-style
# Force one way if the heuristic is wrong:
#   S3_FORCE_PATH_STYLE=true        (R2, B2, MinIO, Wasabi, Storj, …)
#   S3_FORCE_PATH_STYLE=false       (AWS S3 + custom DNS routed buckets)
# S3_FORCE_PATH_STYLE=
